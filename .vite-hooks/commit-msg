# Enforces the commit message convention from CLAUDE.md.
subject=$(grep -v -e '^#' -e '^[[:space:]]*$' "$1" | head -n 1)

# Commits generated by git itself follow their own format.
case "$subject" in
  fixup!* | squash!* | amend!* | "Merge "* | "Revert "*) exit 0 ;;
esac

fail() {
  echo "✖ Invalid commit message: \"$subject\""
  echo "  $1"
  echo "  Example: \"Add login form\""
  exit 1
}

verb=${subject%% *}

echo "$subject" | grep -Eq '^[A-Z][a-z]+( |$)' ||
  fail "Start with a capitalized English verb in imperative mood."
if echo "$verb" | grep -Eq 's$' && ! echo "$verb" | grep -Eq '(ss|us)$'; then
  fail "Use imperative mood: \"Add\", not \"Adds\"."
fi
if echo "$verb" | grep -Eq 'ed$' && ! echo "$verb" | grep -Eq '(eed|bed)$'; then
  fail "Use imperative mood: \"Fix\", not \"Fixed\"."
fi
echo "$subject" | grep -Eq 'ä|ö|ü|Ä|Ö|Ü|ß' &&
  fail "Write commit messages in English."
case "$subject" in
  *.) fail "Do not end the subject with a period." ;;
esac
[ ${#subject} -le 72 ] ||
  fail "Keep the subject at most 72 characters (currently ${#subject})."
exit 0
