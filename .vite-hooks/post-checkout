# Installs the dependencies after switching branches if the lockfile differs.
previous_head=$1
new_head=$2
is_branch_checkout=$3

[ "$is_branch_checkout" = 1 ] || exit 0
git diff --quiet "$previous_head" "$new_head" -- pnpm-lock.yaml && exit 0

echo "pnpm-lock.yaml changed, installing dependencies …"
vp install
