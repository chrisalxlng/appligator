{
  "mcpServers": {
    "playwright": {
      "command": "vp",
      "args": [
        "dlx",
        "-s",
        "@playwright/mcp@0.0.83",
        "--isolated",
        "--output-dir",
        ".playwright-mcp"
      ]
    },
    "chrome-devtools": {
      "command": "vp",
      "args": ["dlx", "-s", "chrome-devtools-mcp@1.10.1", "--isolated"]
    }
  }
}
