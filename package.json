{
  "name": "appligator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ready": "vp check && vp test && vp run -r build",
    "dev": "vp run --filter @appligator/web --filter @appligator/api --parallel dev",
    "storybook": "vp run @appligator/ui#storybook",
    "prepare": "vp config"
  },
  "devDependencies": {
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22.18.0"
  }
}
